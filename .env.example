# =============================================================================
# F.L.U.I.D - Variáveis de Ambiente
# Copie para .env e preencha os valores
# =============================================================================

# --- API Keys ---
OPENAI_API_KEY=sk-...
NCBI_API_KEY=
CHEMBL_API_KEY=

# --- Redis (Celery Broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Paths ---
VINA_BINARY_PATH=/usr/local/bin/vina
WORKSPACE_DIR=./workspace

# --- Logging ---
LOG_LEVEL=INFO
